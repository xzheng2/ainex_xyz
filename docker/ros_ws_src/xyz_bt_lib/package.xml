<?xml version="1.0"?>
<package format="2">
  <name>xyz_bt_lib</name>
  <version>2.0.0</version>
  <description>BT framework library for the Ainex humanoid. The perception/nav nodes it
  consumes live in the separate xyz_perception package.</description>

  <maintainer email="xzheng2@laurentian.ca">xzheng2</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>ainex_interfaces</build_depend>
  <build_depend>message_generation</build_depend>
  <!-- depth_nav_adapter subscribes to xyz_perception/DepthNavState, so the message
       headers must be generated before this package builds. The dependency runs one
       way only: nothing in xyz_perception imports xyz_bt_lib. -->
  <depend>xyz_perception</depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>ainex_interfaces</exec_depend>
  <exec_depend>ainex_kinematics</exec_depend>
  <exec_depend>ros_robot_controller</exec_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>py_trees</exec_depend>
</package>
