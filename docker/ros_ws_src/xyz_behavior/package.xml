<?xml version="1.0"?>
<package format="2">
  <name>xyz_behavior</name>
  <version>0.1.0</version>
  <description>Behavior tree project container for Ainex humanoid robot</description>

  <maintainer email="xzheng2@laurentian.ca">xzheng2</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>ainex_interfaces</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>ainex_interfaces</exec_depend>
  <!-- bt_ros_io/ is the binding layer: default_runtime_io.py imports
       ros_robot_controller/BuzzerState, and the generated entry point constructs
       ainex_kinematics' GaitManager / MotionManager for it. Both were declared by
       xyz_bt_lib while _RuntimeIO lived there. -->
  <exec_depend>ros_robot_controller</exec_depend>
  <exec_depend>ainex_kinematics</exec_depend>
  <exec_depend>xyz_bt_lib</exec_depend>
  <exec_depend>xyz_perception</exec_depend>
  <exec_depend>xyz_run_lab</exec_depend>
  <exec_depend>py_trees_msgs</exec_depend>
  <exec_depend>unique_id</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
</package>
